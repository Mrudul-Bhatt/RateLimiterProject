{
  "//": "Run with --environment Proxy to actually forward to Level7.Backend via YARP.",
  "Gateway": { "Limit": 5, "WindowSeconds": 30, "DegradeMode": "LocalFallback", "Fallback": { "Limit": 3 } },
  "ReverseProxy": {
    "Routes": {
      "all": { "ClusterId": "backend", "Match": { "Path": "{**catch-all}" } }
    },
    "Clusters": {
      "backend": { "Destinations": { "d1": { "Address": "http://localhost:5099/" } } }
    }
  }
}
