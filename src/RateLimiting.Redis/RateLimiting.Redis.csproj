<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\shared\RateLimiting.Abstractions\RateLimiting.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- StackExchange.Redis transitively brings Microsoft.Extensions.Logging.Abstractions (ILogger). -->
    <PackageReference Include="StackExchange.Redis" Version="3.0.11" />
  </ItemGroup>

  <!-- Lua scripts shipped as embedded resources, loaded via the assembly manifest at startup. -->
  <ItemGroup>
    <EmbeddedResource Include="Scripts\fixed_window.lua" />
    <EmbeddedResource Include="Scripts\sliding_window.lua" />
    <EmbeddedResource Include="Scripts\cost_window.lua" />
  </ItemGroup>

</Project>
